  "sampler": {
    "enabled": true,
    "target_structures": [
      "Br2a",
      "Br2b"
    ],
    "target_positive_prob": 0.3,
    "target_hard_negative_prob": 0.3,
    "general_foreground_prob": 0.3,
    "random_prob": 0.1,
    "centre_jitter": 64,
    "samples_per_epoch": null,
    "decoded_cache_size": 2,
    "cache_dir": "metadata/anatomy_sampler_cache",
    "force_rebuild_cache": false,
    "seed": 42
  }

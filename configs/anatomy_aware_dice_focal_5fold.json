{
  "experiment_name": "AnatomyAware_DiceFocal_5Fold",
  "loss_name": "focal_dice",
  "root_dir": "ventral",
  "metadata_csv": "metadata/metadata.csv",
  "baseline_manifest_root": "metadata/final_cv_190",
  "output_root": "outputs/anatomy_aware_dice_focal",
  "n_splits": 5,
  "seed": 42,
  "epochs": 200,
  "batch_size": 2,
